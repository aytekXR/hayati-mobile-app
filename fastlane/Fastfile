# Fastfile — Hayati release automation (Flutter + fastlane match).
#
# Signing model (Session 039): GitHub-hosted macOS runners have NO Xcode-managed
# Apple ID and NO signing certificate, so `flutter build ipa`'s automatic cloud
# signing fails ("No valid code signing certificates were found"). fastlane
# `match` fixes this the way the sibling Unhooked app does: it stores the Apple
# Distribution certificate + App Store profile (encrypted) in MATCH_GIT_URL and
# installs them into the CI keychain, then the build signs MANUALLY against them.
#
# iOS-first (ADR-006): no `platform :android` block until M6.5.
#
# Lanes shell out to the Flutter app at ../app, relative to this fastlane/ dir.

default_platform(:ios)

# Credential checks, scoped PER LANE (ADR-032 D5). Missing any input fails
# CLOSED with a message naming exactly what is absent.
#
# The split is load-bearing, not tidiness. `store_metadata` signs nothing and
# touches no certificate, but it was routed through the match-aware check below
# — so it aborted before `deliver` on EVERY release, inside a step that is
# `continue-on-error: true` by design (ADR-020 D8), which rendered the failure
# GREEN. Store metadata was never once delivered. That is this repo's own
# recorded lesson repeating: a bound justified by one caller's constraints is
# not safe for another caller. `tool/release_lane_lint.dart` now pins which
# lane calls which.

# The App Store Connect API key alone — everything `deliver` needs.
def ensure_asc_credentials!
  required = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_API_KEY_P8_BASE64]
  missing = required.select { |key| (ENV[key] || "").strip.empty? }
  return if missing.empty?

  UI.user_error!(
    "App Store Connect credentials are not configured: #{missing.join(', ')} " \
    "#{missing.length == 1 ? 'is' : 'are'} unset (ASC_KEY_ID, ASC_ISSUER_ID, " \
    "ASC_API_KEY_P8_BASE64). In CI these are hayati repo secrets; see " \
    "docs/operator-expected.md."
  )
end

# The above PLUS the fastlane match inputs — required only by lanes that sign.
def ensure_release_credentials!
  ensure_asc_credentials!

  required = %w[MATCH_GIT_URL MATCH_PASSWORD]
  missing = required.select { |key| (ENV[key] || "").strip.empty? }
  return if missing.empty?

  UI.user_error!(
    "Release signing is not configured: #{missing.join(', ')} " \
    "#{missing.length == 1 ? 'is' : 'are'} unset. Provide the fastlane match " \
    "inputs (MATCH_GIT_URL, MATCH_PASSWORD) — they carry the Apple " \
    "Distribution certificate and App Store profile. In CI these are hayati " \
    "repo secrets; see docs/operator-expected.md."
  )
end

platform :ios do
  desc "Build iOS unsigned (debug) — mirrors the ci.yml build smoke; no signing required"
  lane :build_debug do
    sh("cd ../app && flutter build ios --no-codesign --debug")
  end

  desc "Build (Flutter) + sign (match, manual) + upload to TestFlight"
  lane :beta do
    ensure_release_credentials!
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    # match: distribution cert + App Store profile for com.beyondkaira.hayati.
    # FIRST run only: set repo Variable MATCH_BOOTSTRAP=true so match CREATES +
    # pushes them to MATCH_GIT_URL, then delete it (CI stays read-only after).
    match(
      type: "appstore",
      readonly: ENV["MATCH_BOOTSTRAP"] != "true",
      app_identifier: "com.beyondkaira.hayati",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      api_key: api_key
    )
    profile = ENV.fetch("sigh_com.beyondkaira.hayati_appstore_profile-name")

    # Flutter ships CODE_SIGN_STYLE Automatic; pin MANUAL signing onto the Runner
    # target with the match profile so the archive uses the installed cert+profile.
    # NB: fastlane actions resolve paths from the REPO ROOT (unlike sh blocks,
    # which run from fastlane/) — so this is app/ios/…, not ../app/ios/….
    update_code_signing_settings(
      path: "app/ios/Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: "UH7MXG7Z94",
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    # Manual-signing export options referencing the match profile.
    export_plist = File.expand_path("../app/ios/ExportOptions.plist", __dir__)
    File.write(export_plist, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
        <key>method</key><string>app-store</string>
        <key>teamID</key><string>UH7MXG7Z94</string>
        <key>signingStyle</key><string>manual</string>
        <key>provisioningProfiles</key><dict>
          <key>com.beyondkaira.hayati</key><string>#{profile}</string>
        </dict>
        <key>uploadSymbols</key><true/>
      </dict></plist>
    PLIST

    # Build NUMBER: synthesized here, monotonic per CI run, offset past the
    # manual builds 1-3 (ADR-032 D3 supersedes ADR-021 D3's "no auto-increment
    # magic in CI"). The evidence for the reversal is this lane's own history:
    # six consecutive runs failed before one succeeded, and under pubspec's +N
    # every retry would have cost a commit AND a re-tag to get a fresh number.
    # Accepted cost, stated plainly: re-running the same tag now produces a
    # DIFFERENT build, so App Store Connect — not this repo — answers "which
    # build was v0.1.0?".
    build_number = 100 + ENV.fetch("GITHUB_RUN_NUMBER", "1").to_i
    rc_key = ENV["REVENUECAT_IOS_API_KEY"].to_s

    # Build NAME: deliberately NOT passed. `flutter build ipa` then reads
    # app/pubspec.yaml, which is what `preflight`'s tag<->pubspec gate checks.
    # This lane used to pass `--build-name=0.1.0` as a literal, which made that
    # gate vacuous — it still ran, still passed, and guarded a string the build
    # ignored (tag v0.2.0 + pubspec 0.2.0 would have shipped a binary stamped
    # 0.1.0). Pinned by tool/release_lane_lint.dart. ADR-032 D3.
    sh("cd ../app && flutter build ipa --release -t lib/main_prod.dart " \
       "--build-number=#{build_number} " \
       "--dart-define=REVENUECAT_IOS_API_KEY=#{rc_key} " \
       "--export-options-plist ios/ExportOptions.plist")

    # ABSOLUTE glob (CWD-agnostic): raw Ruby Dir[] uses Dir.pwd (= fastlane/), while
    # fastlane ACTIONS like pilot expand paths from the repo root — so a relative
    # path is ambiguous. __dir__ is fastlane/; the IPA lands at <repo>/app/build/….
    ipa_path = Dir[File.expand_path("../app/build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!(
      "No .ipa under app/build/ios/ipa/ — flutter build ipa did not export."
    ) if ipa_path.nil?

    pilot(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Push App Store metadata (no binary) from fastlane/metadata — App Store Connect API key"
  lane :store_metadata do
    # ASC credentials ONLY — this lane signs nothing (ADR-032 D5). It called
    # ensure_release_credentials! until S047, which required the two MATCH_*
    # inputs that release.yml does not pass to this step, so the lane aborted
    # before `deliver` on every release while the job reported success.
    ensure_asc_credentials!

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
    )
  end
end

# platform :android — intentionally absent until M6.5 (ADR-006).
